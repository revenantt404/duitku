# Copy jadi .env di lokal:  cp .env.example .env  (lalu isi PROJECT_REF + PASSWORD)
# Di Vercel cukup: Storage → Connect → Supabase — env auto-keisi, gak perlu isi manual.

# === SUPABASE ===
# Ambil di https://supabase.com/dashboard/project/[PROJECT_REF]/settings/api
# PENTING (bug infinite-loading produksi): DATABASE_URL HARUS via pooler port 6543
# (+ ?pgbouncer=true) agar koneksi serverless Vercel tidak habis/timeout.
# Port 5432 = direct connection — hanya untuk DIRECT_URL (migrate/db push).
# Format pooler (Supabase): postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# === NEXTJS ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# === FEEDBACK (opsional) ===
NEXT_PUBLIC_FEEDBACK_EMAIL="hello@duitku.app"
NEXT_PUBLIC_FEEDBACK_WA="6280000000000"
